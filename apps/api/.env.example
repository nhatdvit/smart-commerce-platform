#==============================================================================
# Laravel API environment
#
# Copy to apps/api/.env for running the API directly on your machine:
#   cp apps/api/.env.example apps/api/.env && php artisan key:generate
#
# Inside Docker this file is NOT used: Compose injects the environment from the
# repository-root .env (see infra/compose.yaml). Two files, two jobs - the root
# one configures the stack, this one configures the framework.
#
# Never commit a real .env.
#==============================================================================

APP_NAME="Smart Commerce Platform"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Application time is UTC. Per-store timezones live in the stores table and are
# what schedules and daily quotas are evaluated in.
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

#------------------------------------------------------------------- PostgreSQL
# PostgreSQL is the source of truth. SQLite is not supported: row locking,
# partial indexes and TIMESTAMPTZ behaviour are load-bearing here.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smart_commerce
DB_USERNAME=scp_app
DB_PASSWORD=change_me_local_only

#------------------------------------------------------------------------ Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

# Redis is cache and queue transport only, never authoritative for orders,
# payments or stock.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

#------------------------------------------------------------- Auth and clients
# Hosts allowed to authenticate with cookies (Sanctum first-party SPA flow).
SANCTUM_STATEFUL_DOMAINS=localhost:3001,localhost:3002
# Exact browser origins. Never a wildcard outside local development.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Behind the Nginx gateway. Narrow this to the gateway subnet in production
# rather than trusting every proxy header.
TRUSTED_PROXIES=*

#------------------------------------------------------------------ Commerce
COMMERCE_DEFAULT_STORE_TIMEZONE=Asia/Ho_Chi_Minh
# Single-store deployment: the store used when no route parameter or host
# mapping identifies one. Matches the demo store from the seeder.
COMMERCE_DEFAULT_STORE_SLUG=cho-lon-district-1
# Multi-store: comma-separated host=slug pairs, e.g.
#   COMMERCE_STORE_HOSTS=shop1.example.com=store-one,shop2.example.com=store-two
COMMERCE_STORE_HOSTS=

COMMERCE_ORDER_CODE_PREFIX=SCP
# MVP payments are CASH and BANK_TRANSFER only. A generated VietQR is not a
# confirmation of payment; authorized staff confirm the actual bank credit.
COMMERCE_BANK_TRANSFER_EXPIRY_MINUTES=30
COMMERCE_TRANSFER_REFERENCE_PREFIX=SCP
COMMERCE_STOCK_RESERVATION_TTL_MINUTES=30
COMMERCE_IDEMPOTENCY_RETENTION_HOURS=24

COMMERCE_RATE_LIMIT_READ=120
COMMERCE_RATE_LIMIT_WRITE=20

# Provider still undecided; both default to a no-op so nothing silently fails
# to send and nothing accidentally sends.
COMMERCE_NOTIFICATION_EMAIL_PROVIDER=none
COMMERCE_NOTIFICATION_SMS_PROVIDER=none

#------------------------------------------------------------- Queue and worker
# Horizon supervises the queue workers; see config/horizon.php.
HORIZON_PREFIX=scp_horizon

#--------------------------------------------------------------- Observability
# json for deployed environments, so logs are machine-readable.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

#------------------------------------------------------------------- Storage
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=scp-media
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

#---------------------------------------------------------------------- Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

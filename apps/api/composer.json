{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "smart-commerce/api",
  "type": "project",
  "description": "Smart Commerce Platform API: Laravel modular monolith serving the customer storefront and the operations dashboard.",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "dedoc/scramble": "^0.13.53",
    "laravel/framework": "^13.40",
    "laravel/horizon": "^5.50",
    "laravel/sanctum": "^4.3",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.14",
    "laravel/pail": "^1.2.5",
    "laravel/pint": "^1.32",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "pestphp/pest": "^5.3",
    "pestphp/pest-plugin-laravel": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "format": "pint",
    "format:check": "pint --test",
    "stan": "phpstan analyse --memory-limit=1G",
    "test": "pest",
    "test:unit": "pest --testsuite=Unit",
    "test:feature": "pest --testsuite=Feature",
    "test:coverage": "pest --coverage",
    "openapi": "@php artisan scramble:export --path=storage/app/openapi.json",
    "check": [
      "@format:check",
      "@stan",
      "@test"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

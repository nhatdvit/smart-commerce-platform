# Keep installs reproducible and explicit about peer dependencies.
strict-peer-dependencies=false
auto-install-peers=true
resolution-mode=highest

# FILESYSTEM REQUIREMENT
# pnpm links workspace packages with symlinks, so the repository must live on a
# filesystem that supports them: NTFS, APFS, ext4, btrfs. On exFAT or FAT32
# every install fails with EISDIR, and no pnpm setting works around it -
# node-linker=hoisted and inject-workspace-packages do not help, because the
# workspace package links themselves are symlinks. See README "Prerequisites".

#==============================================================================
# Smart Commerce Platform - stack environment
#
#   cp .env.example .env
#
# This file configures the Docker Compose STACK: container images, ports,
# credentials and the environment injected into the api, worker and scheduler
# containers.
#
# Running the Laravel API directly on your machine instead uses
# apps/api/.env (see apps/api/.env.example). Two files, two jobs.
#
# .env is local only and gitignored. Production values come from the deployment
# secret store, never from a file on the host.
#==============================================================================

COMPOSE_PROJECT_NAME=smart-commerce

#--------------------------------------------------------------- Application
APP_NAME="Smart Commerce Platform"
APP_ENV=local
# Generate once, then paste here:
#   docker compose --env-file .env -f infra/compose.yaml run --rm api php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Application time is UTC. Per-store timezones live in the stores table.
APP_TIMEZONE=UTC

#--------------------------------------------------------------------- Ports
# Only the gateway is published. PostgreSQL and Redis bind to 127.0.0.1 in
# development and to nothing at all in production.
GATEWAY_HTTP_PORT=8080
CUSTOMER_WEB_PORT=3001
ADMIN_WEB_PORT=3002
POSTGRES_PORT=5432
REDIS_PORT=6379

#---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=smart_commerce
POSTGRES_USER=scp_app
POSTGRES_PASSWORD=change_me_local_only

# What the api and worker containers connect with (service name, not localhost).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=smart_commerce
DB_USERNAME=scp_app
DB_PASSWORD=change_me_local_only

# Separate, more privileged credentials used only by the one-off migrate job.
# In production these differ from the runtime user, which needs no DDL rights.
MIGRATION_DB_USERNAME=scp_migrator
MIGRATION_DB_PASSWORD=change_me_local_only

#---------------------------------------------------------------------- Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

#--------------------------------------------------------------------- Queues
HORIZON_PREFIX=scp_horizon
# Dashboard is gated by a Gate in config; never expose it publicly unguarded.
HORIZON_PATH=horizon

#------------------------------------------------------------- Auth and CORS
# Hosts allowed to authenticate with cookies (Sanctum first-party SPA flow).
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:3001,localhost:3002
# Exact browser origins. Never a wildcard outside local development.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8080
# Narrow to the gateway subnet in production instead of trusting every proxy.
TRUSTED_PROXIES=*

#------------------------------------------------------------------- Commerce
COMMERCE_DEFAULT_STORE_TIMEZONE=Asia/Ho_Chi_Minh
COMMERCE_DEFAULT_STORE_SLUG=cho-lon-district-1
COMMERCE_STORE_HOSTS=
COMMERCE_ORDER_CODE_PREFIX=SCP

# MVP payments are CASH and BANK_TRANSFER only (fixed decision, 2026-11-09).
# A generated VietQR is not a confirmation of payment.
COMMERCE_BANK_TRANSFER_EXPIRY_MINUTES=30
COMMERCE_TRANSFER_REFERENCE_PREFIX=SCP
COMMERCE_STOCK_RESERVATION_TTL_MINUTES=30
COMMERCE_IDEMPOTENCY_RETENTION_HOURS=24

COMMERCE_RATE_LIMIT_READ=120
COMMERCE_RATE_LIMIT_WRITE=20

COMMERCE_NOTIFICATION_EMAIL_PROVIDER=none
COMMERCE_NOTIFICATION_SMS_PROVIDER=none

#-------------------------------------------------------------- Observability
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

#--------------------------------------------------------------- Frontends
# Inlined into the browser bundle at build time; public by definition.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_NAME="Smart Commerce Platform"
# Server-side calls inside the docker network go through the gateway, so the
# API sees the same host and CORS/Sanctum rules as a browser would.
INTERNAL_API_BASE_URL=http://gateway:8080/api/v1

#------------------------------------------- Object storage (MinIO for local)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=scp-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

#------------------------------------ Monitoring (profile "monitoring", local)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
GRAFANA_ADMIN_PASSWORD=change_me_local_only

#--------------------------------------- Deployed environments only (prod.yaml)
# Versioned image tags; :latest is never deployed.
# API_IMAGE=registry.example.com/scp-api:1.4.2
# CUSTOMER_WEB_IMAGE=registry.example.com/scp-customer-web:1.4.2
# ADMIN_WEB_IMAGE=registry.example.com/scp-admin-web:1.4.2
